# HTTP server
PORT=3000
MCP_AUTH_MODE=token
MCP_ACCESS_TOKEN=replace-with-a-long-random-secret

# Hostinger SSH details (copy from hPanel -> Websites -> Dashboard -> SSH Access)
HOSTINGER_SSH_HOST=185.185.185.185
HOSTINGER_SSH_PORT=65002
HOSTINGER_SSH_USER=u123456789

# Prefer SSH key authentication. Use ONE of these two variables.
# Multiline key can be pasted directly, or use literal \n sequences.
HOSTINGER_SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
# HOSTINGER_SSH_PRIVATE_KEY_BASE64=
# HOSTINGER_SSH_PASSPHRASE=

# Only this directory and its descendants are accessible to MCP tools.
HOSTINGER_ROOT=/home/u123456789/domains/example.com/public_html

# Optional exact deployment command. The run_deploy tool cannot execute any other command.
# HOSTINGER_DEPLOY_COMMAND=cd /home/u123456789/domains/example.com/public_html && git pull --ff-only

# Safety / limits
MAX_READ_BYTES=1048576
MAX_WRITE_BYTES=1048576
SSH_READY_TIMEOUT_MS=20000
SFTP_OPERATION_TIMEOUT_MS=30000
DEPLOY_TIMEOUT_MS=120000

# Instagram single-account auto-posting
# Instagram must be a Professional account (Business or Creator), not a consumer Personal account.
# Recommended: configure OAuth once, then use the MCP instagram_connect_url tool.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Defaults to PUBLIC_BASE_URL/instagram/callback when omitted.
# INSTAGRAM_REDIRECT_URI=https://mcp.example.com/instagram/callback
# Optional: paste the Embed URL generated by Meta Business Login settings.
# INSTAGRAM_LOGIN_URL=
# Optional dedicated state-signing secret; otherwise MCP_ACCESS_TOKEN is used.
# INSTAGRAM_OAUTH_STATE_SECRET=

# Manual-token fallback (not needed after browser OAuth connection)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=v26.0

# Public HTTPS base URL of this MCP server.
# Generated images are served at /generated/... so Instagram can fetch them.
PUBLIC_BASE_URL=https://mcp.example.com

# OpenAI API (billed separately from ChatGPT subscriptions)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium

# Schedule defaults
DEFAULT_TIMEZONE=Asia/Kolkata
INSTAGRAM_DEFAULT_PROMPT=Create a useful Instagram post about AI, websites, design, coding, or automation.
# INSTAGRAM_STATE_FILE=.data/instagram.json
# INSTAGRAM_GENERATED_DIR=.data/generated
